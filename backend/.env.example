# Copy this file and name the copy `.env` (no `.example` on the end).
#
#   Windows PowerShell:  copy .env.example .env
#   Mac / Linux:         cp .env.example .env
#
# Then fill in the blanks below. NEVER commit your .env — it is in .gitignore
# so git will ignore it for you, but don't fight that.

# Free, and does not ask for a card: https://console.groq.com/keys
#
# Leave it blank and everything still works EXCEPT reading handwriting: a
# scanned PDF or a photo of your notes is refused with a sentence telling you
# to set this. Typed PDFs, .txt and .md never need it. Slice 4 needs it too.
GROQ_API_KEY=

# The name of the SQLite database file. The default is fine — leave it alone
# unless you have a reason. Delete the file to start over with an empty app.
DATABASE_FILE=nibble.db

# Who is signed in (slice 4.5)
#
# The backend checks the sign-in token the frontend sends, so your notes are
# yours and nobody else's. This is the value Clerk calls the "Frontend API URL"
# — it looks like https://something-12.clerk.accounts.dev and it is in the Clerk
# dashboard under API keys, next to the publishable key the frontend uses.
#
# It is NOT a secret: it is a public address, and it is inside every token any
# browser is holding. It still has to be set, because it is different for every
# Clerk application — and the backend refuses to start without it rather than
# starting up and answering "you're not signed in" to everything.
CLERK_ISSUER=

# Which web addresses are allowed to call this backend, comma-separated.
#
# The default is the Vite dev server, which is all you need on your laptop. The
# deployed frontend lives at a vercel.app address, so the deployed backend needs
# that address here too — see docs/deploying.md. No trailing slashes.
CORS_ORIGINS=http://localhost:5173

# Reading handwriting and scans (slice 1.5)
# Uses the same free GROQ_API_KEY above — a scanned PDF or a photo of your
# notes gets read by a vision model, because there is no text in it to extract.
# Set to false to switch that off; scans are then refused with a plain sentence.
OCR_ENABLED=true
