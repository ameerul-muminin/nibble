# Copy this file and name the copy `.env` (no `.example` on the end).
#
#   Windows PowerShell:  copy .env.example .env
#   Mac / Linux:         cp .env.example .env
#
# Then fill in the blanks below. NEVER commit your .env — it is in .gitignore
# so git will ignore it for you, but don't fight that.

# Free, and does not ask for a card: https://console.groq.com/keys
#
# Leave it blank and everything still works EXCEPT reading handwriting: a
# scanned PDF or a photo of your notes is refused with a sentence telling you
# to set this. Typed PDFs, .txt and .md never need it. Slice 4 needs it too.
GROQ_API_KEY=

# The name of the SQLite database file. The default is fine — leave it alone
# unless you have a reason. Delete the file to start over with an empty app.
DATABASE_FILE=nibble.db

# Reading handwriting and scans (slice 1.5)
# Uses the same free GROQ_API_KEY above — a scanned PDF or a photo of your
# notes gets read by a vision model, because there is no text in it to extract.
# Set to false to switch that off; scans are then refused with a plain sentence.
OCR_ENABLED=true
