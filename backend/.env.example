# Copy this file to .env and fill in real values. NEVER commit .env.

DATABASE_URL=postgresql+psycopg://nibble:nibble@localhost:5432/nibble

# Your LLM provider. Pick ONE and fill in its key.
LLM_PROVIDER=openai
LLM_API_KEY=put-your-key-here
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small

# Must match the dimension your embedding model outputs.
# text-embedding-3-small -> 1536
EMBEDDING_DIM=1536

# Where the frontend runs, so the browser is allowed to call us.
CORS_ORIGINS=http://localhost:5173
